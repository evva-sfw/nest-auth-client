{
  "name": "@evva/nest-auth-client",
  "version": "2.0.0",
  "description": "An Auth Service Client for Nest.js",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "author": "EVVA Sicherheitstechnologie GmbH",
  "license": "EVVA Software License",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evva-sfw/nest-auth-client.git"
  },
  "bugs": {
    "url": "https://github.com/evva-sfw/nest-auth-client/issues"
  },
  "keywords": [
    "nestjs",
    "auth",
    "client"
  ],
  "scripts": {
    "build": "rimraf dist && npx nest build",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "lint": "npx eslint -c eslint.config.ts",
    "lint:fix": "npm run lint -- --fix ",
    "fmt": "npx prettier -- --write",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepack": "npx nest build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "luxon": "^3.5.0",
    "node-vault": "^0.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/testing": "^12.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^25.5.0",
    "auto-changelog": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "3.8.1",
    "prettier-eslint": "^17.1.2",
    "reflect-metadata": "^0.2.2",
    "@eslint/js": "^10.0.1",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsc-watch": "7.2.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {}
}
